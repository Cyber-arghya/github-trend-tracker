# Supabase Configuration
# Obtain these from your Supabase dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key

# Storage Mode:
# 'supabase' (default) -> Store all snapshots, repos, queue, and summaries in Supabase
# 'dual' -> Store in Supabase and also write local markdown/json files
# 'local' -> Fallback to local files only if Supabase is offline/not configured
STORAGE_MODE=supabase

